
<odoo>
    <record id="view_force_delivery_wizard_form" model="ir.ui.view">
        <field name="name">force.delivery.wizard.form</field>
        <field name="model">force.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Force Delivery?">
                <group>
                    <label for="insufficient_products" string="The following products are out of stock:"/>
                    <field name="insufficient_products" readonly="1"/>
                    <field name="picking_id" readonly="1"/>
                </group>
                <footer>
                    <button string="Force Delivery" type="object" name="action_force_delivery" class="btn-primary"/>
                    <button string="Keep Pending" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
