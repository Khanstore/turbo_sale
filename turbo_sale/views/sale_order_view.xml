
<odoo>
    <record id="view_sale_order_form_confirm_all" model="ir.ui.view">
        <field name="name">sale.order.form.confirm.all</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_confirm_all_with_prompts"
        string="Turbo Confirm"
        type="object"
        class="btn-primary"
        groups="sales_team.group_sale_manager"
                        invisible="state != 'draft'"
/>
            </xpath>
        </field>
    </record>
</odoo>
