<odoo>
    <record id="view_sale_order_form_confirm_all" model="ir.ui.view">
        <field name="name">sale.order.form.confirm.all</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="cod_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </field>
            <xpath expr="//header" position="inside">
                <button name="action_confirm_all_with_prompts"
            string="Turbo Confirm"
            type="object"
            invisible="is_order_completed"
            class="btn-primary"
            groups="sales_team.group_sale_manager"
    />
            </xpath>
            <xpath expr="//sheet" position="inside">
            <field name="is_order_completed" invisible="1"/>
        </xpath>
        </field>
    </record>
</odoo>
