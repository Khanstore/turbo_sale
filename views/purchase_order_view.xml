<odoo>
    <record id="view_purchase_order_form_confirm_all" model="ir.ui.view">
        <field name="name">purchase.order.form.confirm.all</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_complete_purchase_process"
            string="Turbo Confirm"
            type="object"
            invisible="is_order_completed"
            class="btn-primary"
            groups="sales_team.group_sale_manager"
    />
            </xpath>
            <xpath expr="//sheet" position="inside">
            <field name="is_order_completed" invisible="1"/>
        </xpath>
        </field>
    </record>
</odoo>
