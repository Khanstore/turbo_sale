
<odoo>
   <record id="view_force_delivery_wizard_form" model="ir.ui.view">
    <field name="name">force.delivery.wizard.form</field>
    <field name="model">force.delivery.wizard</field>
    <field name="arch" type="xml">
        <form string="Force Delivery Wizard">
            <group>
                <field name="picking_id"/>
                <field name="is_cash_on_delivery"/>
                <field name="cod_amount"/>
                <field name="carrier_id"/>
                <field name="add_charge"/>
                <field name="insufficient_products"/>
            </group>
            <footer>
                <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                <button string="Cancel" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

